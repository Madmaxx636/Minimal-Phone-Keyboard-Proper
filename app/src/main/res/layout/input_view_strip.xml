<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?android:attr/windowBackground">

    <View
        android:layout_width="match_parent"
        android:layout_height="1.125dp"
        android:background="?android:attr/textColorPrimary" />

    <!-- Quick actions on the left, word suggestions in the middle, modifier state on the right. -->
    <LinearLayout
        android:id="@+id/suggestion_strip"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/toolbar_emoji"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Emoji picker"
            android:src="@drawable/ic_toolbar_emoji"
            app:tint="?android:attr/textColorPrimary" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/toolbar_clipboard"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Clipboard history"
            android:src="@drawable/ic_toolbar_clipboard"
            app:tint="?android:attr/textColorPrimary" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/toolbar_voice"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Voice typing"
            android:src="@drawable/ic_toolbar_mic"
            app:tint="?android:attr/textColorPrimary" />

        <View
            android:layout_width="1.125dp"
            android:layout_height="32dp"
            android:background="?android:attr/textColorPrimary" />

        <!-- Word suggestions (see SuggestionController): typed word, corrections, completions. -->
        <LinearLayout
            android:id="@+id/suggestions_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/suggestion_0"
                style="@style/ToolbarSuggestion" />

            <TextView
                android:id="@+id/suggestion_1"
                style="@style/ToolbarSuggestion" />

            <TextView
                android:id="@+id/suggestion_2"
                style="@style/ToolbarSuggestion" />
        </LinearLayout>

        <View
            android:layout_width="1.125dp"
            android:layout_height="32dp"
            android:background="?android:attr/textColorPrimary" />

        <!-- One icon for each modifier that is active, added by the input method service. -->
        <LinearLayout
            android:id="@+id/modifier_row"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="48dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            tools:ignore="RtlSymmetry" />
    </LinearLayout>
</LinearLayout>
